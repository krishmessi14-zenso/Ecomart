pipline code 1:
pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/YOUR_USERNAME/student-task-manager.git'
            }
        }
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        stage('Code Check') {
            steps {
                sh 'npm run lint'
            }
        }
        stage('Build React App') {
            steps {
                sh 'npm run build'
            }
        }
    }
    post {
        success {
            archiveArtifacts artifacts: 'dist/**',
                             fingerprint: true
        }
        always {
            echo 'Pipeline execution completed.'
        }
    }
}
