# EcoMart Sustainable E-Commerce Environment Configuration

# Database Configuration (MySQL / MongoDB Atlas / JSON Fallback)
MONGO_URI=mongodb://localhost:27017/ecomart
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# XAMPP default: leave DB_PASSWORD empty
DB_PASSWORD=
DB_NAME=ecomart

# JWT Authentication & Server Secrets
JWT_SECRET=your_jwt_secret_key_here
PORT=5000
CLIENT_URL=http://localhost:5173

# Nodemailer Email Service Configuration (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Admin Credentials
ADMIN_EMAIL=admin@ecomart.com
ADMIN_PASSWORD=Admin@12345

# Mapbox Access Token
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# GeoNames API Username
GEONAMES_USERNAME=your_geonames_username

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
