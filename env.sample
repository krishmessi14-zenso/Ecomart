API CODE FOR LIBRARY:
import { useState, useEffect } from "react";

const API = "http://localhost:3000/books";

export default function App() {
  const [books, setBooks] = useState([]);

  const [form, setForm] = useState({
    title: "",
    author: "",
    category: "",
    quantity: ""
  });

  const [editId, setEditId] = useState(null);
  const [search, setSearch] = useState("");
  const [message, setMessage] = useState("");
  const getBooks = async () => {
    try {
      const response = await fetch(API);

      if (!response.ok) {
        throw new Error("Failed to fetch books");
      }

      const data = await response.json();
      setBooks(data);
    } catch (error) {
      setMessage("Cannot connect.");
    }
  };
  useEffect(() => {
    getBooks();
  }, []);

  const handleChange = (e) => {
    setForm({
      ...form,
      [e.target.name]: e.target.value
    });
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setMessage("");

    if (
      !form.title.trim() ||
      !form.author.trim() ||
      !form.category.trim() ||
      form.quantity === ""
    ) {
      setMessage("Please fill  all fields.");
      return;
    }

    if (
      !Number.isInteger(Number(form.quantity)) ||
      Number(form.quantity) < 0
    ) {
      setMessage("Quantity error");
      return;
    }

    const bookData = {
      title: form.title.trim(),
      author: form.author.trim(),
      category: form.category.trim(),
      quantity: Number(form.quantity)
    };

    try {
      const response = await fetch(
        editId ? `${API}/${editId}` : API,
        {
          method: editId ? "PUT" : "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(bookData)
        }
      );

      if (!response.ok) {
        throw new Error("Unable to save book");
      }

      setMessage(
        editId
          ? "Book updated successfully!"
          : "Book added successfully!"
      );

      resetForm();
      getBooks();
    } catch (error) {
      setMessage("Error saving book. Please try again.");
    }
  };

  const handleEdit = (book) => {
    setForm({
      title: book.title,
      author: book.author,
      category: book.category,
      quantity: String(book.quantity)
    });

    setEditId(book.id);
    setMessage("");
  };

  const handleDelete = async (id) => {
    if (!window.confirm("Do you want to delete this book?")) {
      return;
    }

    try {
      const response = await fetch(`${API}/${id}`, {
        method: "DELETE"
      });

      if (!response.ok) {
        throw new Error("Unable to delete book");
      }

      if (editId === id) {
        resetForm();
      }

      setMessage("Book deleted successfully!");
      getBooks();
    } catch (error) {
      setMessage("Error deleting book.");
    }
  };

  const resetForm = () => {
    setForm({
      title: "",
      author: "",
      category: "",
      quantity: ""
    });

    setEditId(null);
  };

  const filteredBooks = books.filter((book) =>
    `${book.title} ${book.author} ${book.category}`
      .toLowerCase()
      .includes(search.toLowerCase())
  );

  return (
    <div className="app">
      <header>
        <h1>Library Management System</h1>
        <p>Add, view, update, and delete library books</p>
      </header>

      <main className="container">
        <section className="form-section">
          <h2>{editId ? "Update Book" : "Add New Book"}</h2>
          <form onSubmit={handleSubmit}>
            <label>Book Title</label>
            <input
              type="text"
              name="title"
              placeholder="Enter book title"
              value={form.title}
              onChange={handleChange}
              required
            />
            <label>Author Name</label>
            <input
              type="text"
              name="author"
              placeholder="Enter author name"
              value={form.author}
              onChange={handleChange}
              required
            />
            <label>Category</label>
            <input
              type="text"
              name="category"
              placeholder="Enter category"
              value={form.category}
              onChange={handleChange}
              required
            />
            <label>Available Quantity</label>
            <input
              type="number"
              name="quantity"
              placeholder="Enter quantity"
              min="0"
              step="1"
              value={form.quantity}
              onChange={handleChange}
              required
            />
            <button type="submit">
              {editId ? "Update Book" : "Add Book"}
            </button>

            {editId && (
              <button
                type="button"
                className="cancel-button"
                onClick={resetForm}
              >
                Cancel Edit
              </button>
            )}
          </form>

          {message && <p className="message">{message}</p>}
        </section>

        <section className="list-section">
          <h2>Book Collection</h2>

          <input
            className="search"
            type="text"
            placeholder="Search by title, author, or category"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
          />

          <p>Total books listed: {books.length}</p>

          {filteredBooks.length === 0 ? (
            <p>No books found.</p>
          ) : (
            <div className="book-list">
              {filteredBooks.map((book) => (
                <BookCard
                  key={book.id}
                  book={book}
                  onEdit={handleEdit}
                  onDelete={handleDelete}
                />
              ))}
            </div>
          )}
        </section>
      </main>

      <footer>
        <p>Library Management System</p>
      </footer>
    </div>
  );
}
function BookCard({ book, onEdit, onDelete }) {
  return (
    <div className="book-card">
      <h3>{book.title}</h3>
      <p><strong>Author:</strong> {book.author}</p>
      <p><strong>Category:</strong> {book.category}</p>
      <p><strong>Quantity:</strong> {book.quantity}</p>

      <button onClick={() => onEdit(book)}>
        Edit
      </button>
      <button
        className="delete-button"
        onClick={() => onDelete(book.id)}
      >
        Delete
      </button>
    </div>
  );
}
